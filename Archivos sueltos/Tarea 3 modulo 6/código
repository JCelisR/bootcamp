import pandas as pd
import numpy as np
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import LabelEncoder, OneHotEncoder, MinMaxScaler, StandardScaler

# 1. Creación del DataFrame con los datos proporcionados
data = {
    'ID': [1, 2, 3, 4],
    'Edad': [25, 45, 30, 40],
    'Ciudad': ['Madrid', 'Sevilla', 'Madrid', 'Barcelona'],
    'Ingresos': [30000, 50000, np.nan, 40000]
}
df = pd.DataFrame(data)

# 2. Imputación de valores faltantes (Ingresos)
imputer = SimpleImputer(strategy='mean')
df['Ingresos'] = imputer.fit_transform(df[['Ingresos']])

# 3. Transformación de la columna Ciudad
# A. Label Encoding
le = LabelEncoder()
df['Ciudad_Label'] = le.fit_transform(df['Ciudad'])

# B. One-Hot Encoding / Variables Dummy
df_dummies = pd.get_dummies(df['Ciudad'], prefix='Ciudad')
df = pd.concat([df, df_dummies], axis=1)

# 4. Escalamiento de variables numéricas (Edad e Ingresos)
# A. Normalización Min-Max (Rango 0 a 1)
scaler_minmax = MinMaxScaler()
df[['Edad_MinMax', 'Ingresos_MinMax']] = scaler_minmax.fit_transform(df[['Edad', 'Ingresos']])

# B. Estandarización Z-Score (Media 0, Desviación Estándar 1)
scaler_z = StandardScaler()
df[['Edad_Z', 'Ingresos_Z']] = scaler_z.fit_transform(df[['Edad', 'Ingresos']])

print(df)
df.to_csv('clientes_preprocesados.csv', index=False)

